# Base URL of the Express API in production. Leave empty when the client and API are
# served from the same domain (the Vercel setup in this repository does that).
VITE_API_URL=

# Development only: where `npm run dev` should proxy /api requests.
# Defaults to http://localhost:5000. Change it if you start the API on another port.
VITE_API_PROXY=http://localhost:5000
